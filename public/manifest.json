{
  "manifest_version": 3,
  "name": "BuildChat - Gestão de leads e pacientes no WhatsApp",
  "description": "Otimize o atendimento com mensagens rápidas, etiquetas e CRM direto no WhatsApp Web.",
  "version": "1.0.0",
  "action": {
    "default_icon": "icons/icon128.png",
    "default_title": "BuildChat"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content-loader.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["vendor/wppconnect-wa.js", "assets/wa-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": ["storage", "unlimitedStorage", "alarms", "tabs"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://*.supabase.co/*"],
  "web_accessible_resources": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "resources": ["assets/*", "vendor/*", "seed/*", "seed/media/*", "icons/*"]
    }
  ]
}
